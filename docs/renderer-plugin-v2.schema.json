{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UtauTTS Renderer package v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "kind", "id", "display_name", "version", "backend", "protocol_version"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"const": 2},
    "kind": {"const": "renderer"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "backend": {"enum": ["waveform", "utautts-world-phrase", "utautts-world-phrase-cuda", "openutau-worldline-r-faithful", "diffsinger"]},
    "protocol_version": {"const": 1},
    "experimental": {"type": "boolean"},
    "default_priority": {"type": "integer"},
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {"id": {"enum": ["world-engine", "worldline-bridge", "worldline", "waveform-gpu", "diffsinger-bridge"]}, "version": {"const": "1"}}
      }
    },
    "platforms": {
      "type": "object",
      "propertyNames": {"pattern": "^(any|[a-z0-9]+-[a-z0-9]+)$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}
        }
      }
    }
  }
}
