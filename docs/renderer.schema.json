{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UtauTTS renderer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "kind", "id", "display_name", "backend"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"const": 1},
    "kind": {"const": "renderer"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "backend": {"enum": ["waveform", "utautts-world-phrase", "utautts-world-phrase-cuda", "openutau-worldline-r-faithful", "utau-external-resampler", "diffsinger"]},
    "experimental": {"type": "boolean"},
    "acceleration": {"enum": ["cpu", "cuda"]},
    "default_priority": {"type": "integer"},
    "update_managed": {"type": "boolean"},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_pitch": {"type": "boolean"},
        "boundary_bridge": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "platforms": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(any|[a-z0-9]+-[a-z0-9]+)$"},
      "uniqueItems": true
    },
    "platform_assets": {
      "type": "object",
      "propertyNames": {"pattern": "^(any|[a-z0-9]+-[a-z0-9]+)$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    }
  }
}
