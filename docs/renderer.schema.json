{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UtauTTS renderer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "kind", "id", "display_name"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"enum": [1, 2]},
    "kind": {"enum": ["renderer", "synthesis-engine"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "backend": {"enum": ["waveform", "utautts-world-phrase", "utautts-world-phrase-cuda", "openutau-worldline-r-faithful", "utau-external-resampler", "diffsinger"]},
    "contract": {"enum": ["unit-renderer", "neural-synthesizer"]},
    "contract_version": {"type": "integer", "minimum": 1},
    "provider": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string", "minLength": 1},
    "protocol": {"const": "utautts-provider"},
    "protocol_version": {"type": "integer", "minimum": 1},
    "provider_args": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "experimental": {"type": "boolean"},
    "acceleration": {"enum": ["cpu", "cuda"]},
    "default_priority": {"type": "integer"},
    "update_managed": {"type": "boolean"},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_pitch": {"type": "boolean"},
        "boundary_bridge": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "executable": {"type": "boolean"}
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(any|[a-z0-9]+-[a-z0-9]+)$"},
      "uniqueItems": true
    },
    "platform_assets": {
      "type": "object",
      "propertyNames": {"pattern": "^(any|[a-z0-9]+-[a-z0-9]+)$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "platform_resources": {
      "type": "object",
      "propertyNames": {"pattern": "^(any|[a-z0-9]+-[a-z0-9]+)$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "required": {"type": "boolean"},
            "executable": {"type": "boolean"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"manifest_version": {"const": 1}}},
      "then": {
        "required": ["backend"],
        "properties": {"kind": {"const": "renderer"}},
        "not": {"anyOf": [{"required": ["contract"]}, {"required": ["provider"]}, {"required": ["provider_version"]}, {"required": ["resources"]}, {"required": ["platform_resources"]}]}
      }
    },
    {
      "if": {"properties": {"manifest_version": {"const": 2}}},
      "then": {
        "required": ["contract", "provider", "provider_version"],
        "properties": {"kind": {"const": "synthesis-engine"}},
        "not": {"anyOf": [{"required": ["backend"]}, {"required": ["version"]}, {"required": ["assets"]}, {"required": ["platform_assets"]}]}
      }
    },
    {
      "if": {
        "properties": {
          "manifest_version": {"const": 2},
          "protocol": {"const": "utautts-provider"}
        },
        "required": ["manifest_version", "protocol"]
      },
      "then": {
        "required": ["contract_version", "protocol_version"],
        "properties": {"contract": {"const": "unit-renderer"}}
      }
    }
  ]
}
