{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "utautts-world-phrase",
  "display_name": "UtauTTS WORLD phrase",
  "description": "UtauTTS WORLD phrase renderer",
  "contract": "unit-renderer",
  "provider": "utautts-world-phrase",
  "provider_version": "1",
  "update_managed": true,
  "acceleration": "cpu",
  "default_priority": 300,
  "capabilities": { "frame_pitch": true },
  "platforms": ["windows-amd64", "linux-amd64", "darwin-amd64", "darwin-arm64", "js-wasm"],
  "platform_resources": {
    "windows-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dll", "required": true }
    },
    "linux-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.so", "required": true }
    },
    "darwin-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dylib", "required": true }
    },
    "darwin-arm64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dylib", "required": true }
    },
    "js-wasm": {
      "world_engine": { "path": "wasm", "required": false }
    }
  }
}
