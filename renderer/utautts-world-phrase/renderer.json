{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "utautts-world-phrase",
  "display_name": "UtauTTS WORLD phrase",
  "description": "WORLD phrase renderer with the UtauTTS bridge",
  "contract": "unit-renderer",
  "provider": "utautts-world-phrase",
  "provider_version": "1",
  "update_managed": true,
  "acceleration": "cpu",
  "default_priority": 300,
  "capabilities": { "frame_pitch": true, "speech_prosody_experiment": true },
  "settings": [
    { "id": "mora_duration_ms", "type": "integer", "group": "timing", "default": 120, "min": 20, "max": 1000, "label": "settings.defaultMoraDuration" },
    { "id": "pause_duration_ms", "type": "integer", "group": "timing", "default": 180, "min": 0, "max": 3000, "label": "settings.defaultPauseDuration" },
    { "id": "leading_preutterance_ms", "type": "integer", "group": "timing", "default": 0, "min": 0, "max": 300, "label": "settings.defaultLeadingPreutterance" },
    { "id": "intonation_strength", "type": "number", "group": "prosody", "default": 2.0, "min": 0, "max": 4, "step": 0.01, "label": "settings.defaultIntonation" },
    { "id": "boundary_tone", "type": "boolean", "group": "correction", "default": true, "label": "settings.boundaryTone" },
    { "id": "stretch_adapt", "type": "boolean", "group": "correction", "default": true, "label": "settings.stretchAdapt" },
    { "id": "pause_context", "type": "boolean", "group": "correction", "default": true, "label": "settings.pauseContext" },
    { "id": "english_weak_form", "type": "boolean", "group": "pronunciation", "default": true, "label": "settings.englishWeakForm" }
  ],
  "platforms": ["windows-amd64", "linux-amd64", "darwin-amd64", "darwin-arm64", "js-wasm"],
  "platform_resources": {
    "windows-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dll", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge.exe", "required": true, "executable": true }
    },
    "linux-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.so", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge", "required": true, "executable": true }
    },
    "darwin-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dylib", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge", "required": true, "executable": true }
    },
    "darwin-arm64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dylib", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge", "required": true, "executable": true }
    },
    "js-wasm": {
      "world_engine": { "path": "wasm", "required": false },
      "worldline_bridge": { "path": "wasm", "required": false }
    }
  }
}
