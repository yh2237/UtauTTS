{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "diffsinger",
  "display_name": "DiffSinger (experimental)",
  "description": "DiffSinger bridge renderer",
  "contract": "neural-synthesizer",
  "provider": "diffsinger",
  "provider_version": "1",
  "update_managed": true,
  "experimental": true,
  "acceleration": "cpu",
  "default_priority": -50,
  "capabilities": { "frame_pitch": true, "internal_timing": true },
  "settings": [
    { "id": "mora_duration_ms", "type": "integer", "group": "timing", "default": 120, "min": 20, "max": 1000, "label": "settings.defaultMoraDuration" },
    { "id": "pause_duration_ms", "type": "integer", "group": "timing", "default": 180, "min": 0, "max": 3000, "label": "settings.defaultPauseDuration" },
    { "id": "leading_preutterance_ms", "type": "integer", "group": "timing", "default": 0, "min": 0, "max": 300, "label": "settings.defaultLeadingPreutterance" },
    { "id": "intonation_strength", "type": "number", "group": "prosody", "default": 4.0, "min": 0, "max": 8, "step": 0.01, "label": "settings.defaultIntonation" },
    { "id": "boundary_tone", "type": "boolean", "group": "correction", "default": true, "label": "settings.boundaryTone" },
    { "id": "stretch_adapt", "type": "boolean", "group": "correction", "default": true, "label": "settings.stretchAdapt" },
    { "id": "pause_context", "type": "boolean", "group": "correction", "default": true, "label": "settings.pauseContext" },
    { "id": "english_weak_form", "type": "boolean", "group": "pronunciation", "default": true, "label": "settings.englishWeakForm" },
    { "id": "diffsinger_steps", "type": "integer", "group": "diffsinger", "default": 0, "min": 0, "max": 100, "label": "settings.defaultDiffSingerSteps" },
    { "id": "diffsinger_expr", "type": "number", "group": "diffsinger", "default": 0, "min": 0, "max": 2, "step": 0.01, "label": "settings.defaultDiffSingerExpr" },
    { "id": "diffsinger_duration_mix", "type": "number", "group": "diffsinger", "default": 0, "min": 0, "max": 1, "step": 0.01, "label": "settings.defaultDiffSingerDurationMix" },
    { "id": "diffsinger_pitch_mix", "type": "number", "group": "diffsinger", "default": 0, "min": 0, "max": 1, "step": 0.01, "label": "settings.defaultDiffSingerPitchMix" }
  ],
  "platforms": ["windows-amd64"],
  "platform_resources": {
    "windows-amd64": {
      "diffsinger_bridge": {
        "path": "../../runtime/utautts-diffsinger-bridge.exe",
        "required": true,
        "executable": true
      }
    }
  }
}
