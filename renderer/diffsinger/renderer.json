{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "diffsinger",
  "display_name": "DiffSinger (experimental)",
  "description": "DiffSinger bridge renderer",
  "contract": "neural-synthesizer",
  "provider": "diffsinger",
  "provider_version": "1",
  "update_managed": true,
  "experimental": true,
  "acceleration": "cpu",
  "default_priority": -50,
  "capabilities": { "frame_pitch": true },
  "settings": [
    { "id": "diffsinger_steps", "type": "integer", "default": 0, "min": 0, "max": 100, "label": "settings.defaultDiffSingerSteps" },
    { "id": "diffsinger_expr", "type": "number", "default": 0, "min": 0, "max": 2, "step": 0.01, "label": "settings.defaultDiffSingerExpr" },
    { "id": "diffsinger_duration_mix", "type": "number", "default": 0, "min": 0, "max": 1, "step": 0.01, "label": "settings.defaultDiffSingerDurationMix" },
    { "id": "diffsinger_pitch_mix", "type": "number", "default": 0, "min": 0, "max": 1, "step": 0.01, "label": "settings.defaultDiffSingerPitchMix" }
  ],
  "platforms": ["windows-amd64"],
  "platform_resources": {
    "windows-amd64": {
      "diffsinger_bridge": {
        "path": "../../runtime/utautts-diffsinger-bridge.exe",
        "required": true,
        "executable": true
      }
    }
  }
}
