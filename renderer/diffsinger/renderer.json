{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "diffsinger",
  "display_name": "DiffSinger (experimental)",
  "description": "DiffSinger bridge renderer",
  "contract": "neural-synthesizer",
  "provider": "diffsinger",
  "provider_version": "1",
  "update_managed": true,
  "experimental": true,
  "acceleration": "cpu",
  "default_priority": -50,
  "capabilities": { "frame_pitch": true },
  "platforms": ["windows-amd64"],
  "platform_resources": {
    "windows-amd64": {
      "diffsinger_bridge": {
        "path": "../../runtime/utautts-diffsinger-bridge.exe",
        "required": true,
        "executable": true
      }
    }
  }
}
