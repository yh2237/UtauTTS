{
  "manifest_version": 1,
  "kind": "renderer",
  "id": "utautts-world-phrase-cuda",
  "display_name": "UtauTTS WORLD phrase (CUDA, experimental)",
  "description": "CUDA waveform renderer",
  "backend": "utautts-world-phrase-cuda",
  "version": "1",
  "update_managed": true,
  "experimental": true,
  "acceleration": "cuda",
  "default_priority": -200,
  "capabilities": { "frame_pitch": true },
  "platforms": ["windows-amd64"],
  "platform_assets": {
    "windows-amd64": {
      "world_engine": "../../runtime/utautts-world-engine.dll",
      "worldline_bridge": "../../runtime/utautts-worldline-bridge.exe",
      "world_gpu": "../../runtime/utautts-waveform-gpu.dll"
    }
  }
}
