{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "utautts-world-phrase-cuda",
  "display_name": "UtauTTS WORLD phrase (CUDA, experimental)",
  "description": "CUDA waveform renderer",
  "contract": "unit-renderer",
  "provider": "utautts-world-phrase-cuda",
  "provider_version": "1",
  "update_managed": true,
  "experimental": true,
  "acceleration": "cuda",
  "default_priority": -200,
  "capabilities": { "frame_pitch": true },
  "platforms": ["windows-amd64"],
  "platform_resources": {
    "windows-amd64": {
      "world_engine": { "path": "../../runtime/utautts-world-engine.dll", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge.exe", "required": true, "executable": true },
      "world_gpu": { "path": "../../runtime/utautts-waveform-gpu.dll", "required": true }
    }
  }
}
