{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "classic-utau",
  "display_name": "Classic UTAU",
  "description": "UTAU-compatible resampler and wavtool renderer",
  "contract": "unit-renderer",
  "provider": "utau-external-resampler",
  "provider_version": "1",
  "update_managed": true,
  "acceleration": "cpu",
  "default_priority": -100,
  "capabilities": { "frame_pitch": true },
  "settings": [
    { "id": "mora_duration_ms", "type": "integer", "group": "timing", "default": 120, "min": 20, "max": 1000, "label": "settings.defaultMoraDuration" },
    { "id": "pause_duration_ms", "type": "integer", "group": "timing", "default": 180, "min": 0, "max": 3000, "label": "settings.defaultPauseDuration" },
    { "id": "leading_preutterance_ms", "type": "integer", "group": "timing", "default": 0, "min": 0, "max": 300, "label": "settings.defaultLeadingPreutterance" },
    { "id": "intonation_strength", "type": "number", "group": "timing", "default": 2.0, "min": 0, "max": 4, "step": 0.01, "label": "settings.defaultIntonation" },
    { "id": "context_duration", "type": "boolean", "group": "timing", "default": true, "label": "settings.contextDuration" },
    { "id": "context_duration_strength", "type": "number", "group": "timing", "default": 1.0, "min": 0, "max": 2, "step": 0.01, "label": "settings.contextDurationStrength" },
    { "id": "boundary_tone", "type": "boolean", "group": "timing", "default": true, "label": "settings.boundaryTone" },
    { "id": "boundary_tone_strength", "type": "number", "group": "timing", "default": 1.0, "min": 0, "max": 2, "step": 0.01, "label": "settings.boundaryToneStrength" },
    { "id": "stretch_adapt", "type": "boolean", "group": "timing", "default": true, "label": "settings.stretchAdapt" },
    { "id": "stretch_adapt_strength", "type": "number", "group": "timing", "default": 1.0, "min": 0, "max": 2, "step": 0.01, "label": "settings.stretchAdaptStrength" },
    { "id": "pause_context", "type": "boolean", "group": "timing", "default": true, "label": "settings.pauseContext" },
    { "id": "pause_context_strength", "type": "number", "group": "timing", "default": 1.0, "min": 0, "max": 2, "step": 0.01, "label": "settings.pauseContextStrength" },
    { "id": "english_weak_form", "type": "boolean", "group": "timing", "default": true, "label": "settings.englishWeakForm" },
    { "id": "resampler", "type": "enum", "group": "classic", "options_source": "resamplers", "default": "", "label": "main.param.resampler" },
    { "id": "wavtool", "type": "enum", "group": "classic", "options_source": "wavtools", "default": "builtin", "label": "main.param.wavtool" }
  ]
}
