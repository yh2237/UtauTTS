{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "classic-utau",
  "display_name": "Classic UTAU",
  "description": "UTAU-compatible resampler and wavtool renderer",
  "contract": "unit-renderer",
  "provider": "utau-external-resampler",
  "provider_version": "1",
  "update_managed": true,
  "acceleration": "cpu",
  "default_priority": -100,
  "capabilities": { "frame_pitch": true },
  "settings": [
    { "id": "mora_duration_ms", "type": "integer", "group": "timing", "default": 140, "min": 20, "max": 1000, "label": "settings.defaultMoraDuration" },
    { "id": "pause_duration_ms", "type": "integer", "group": "timing", "default": 180, "min": 0, "max": 3000, "label": "settings.defaultPauseDuration" },
    { "id": "leading_preutterance_ms", "type": "integer", "group": "timing", "default": 0, "min": 0, "max": 300, "label": "settings.defaultLeadingPreutterance" },
    { "id": "intonation_strength", "type": "number", "group": "timing", "default": 2.0, "min": 0, "max": 4, "step": 0.01, "label": "settings.defaultIntonation" }
  ]
}
