{
  "manifest_version": 2,
  "kind": "synthesis-engine",
  "id": "openutau-worldline-r-faithful",
  "display_name": "OpenUTAU WORLDLINE-R faithful",
  "description": "OpenUTAU WORLDLINE-R faithful renderer",
  "contract": "unit-renderer",
  "provider": "openutau-worldline-r-faithful",
  "provider_version": "1",
  "update_managed": true,
  "acceleration": "cpu",
  "default_priority": 200,
  "capabilities": { "frame_pitch": true },
  "platforms": ["windows-amd64", "linux-amd64"],
  "platform_resources": {
    "windows-amd64": {
      "worldline": { "path": "../../runtime/worldline.dll", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge.exe", "required": true, "executable": true }
    },
    "linux-amd64": {
      "worldline": { "path": "../../runtime/libworldline.so", "required": true },
      "worldline_bridge": { "path": "../../runtime/utautts-worldline-bridge", "required": true, "executable": true }
    }
  }
}
