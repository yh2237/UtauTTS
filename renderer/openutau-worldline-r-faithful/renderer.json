{
  "manifest_version": 1,
  "kind": "renderer",
  "id": "openutau-worldline-r-faithful",
  "display_name": "OpenUTAU WORLDLINE-R faithful",
  "description": "OpenUTAU WORLDLINE-R faithful renderer",
  "backend": "openutau-worldline-r-faithful",
  "version": "1",
  "update_managed": true,
  "acceleration": "cpu",
  "default_priority": 200,
  "capabilities": { "frame_pitch": true },
  "platforms": ["windows-amd64", "linux-amd64"],
  "platform_assets": {
    "windows-amd64": {
      "worldline": "../../runtime/worldline.dll",
      "worldline_bridge": "../../runtime/utautts-worldline-bridge.exe"
    },
    "linux-amd64": {
      "worldline": "../../runtime/libworldline.so",
      "worldline_bridge": "../../runtime/utautts-worldline-bridge"
    }
  }
}
