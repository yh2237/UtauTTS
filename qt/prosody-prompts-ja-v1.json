  "packs": [
    {
      "id": "utautts-original-ja-v1",
      "name": "基本確認セット（10文）",
      "source": "utautts-original",
      "prompts": [
        {
          "id": "original-p0001",
          "text": "こんにちは、今日はいい天気です。"
        },
        {
          "id": "original-p0002",
          "text": "明日の午後、駅前の図書館で会いませんか？"
        },
        {
          "id": "original-p0003",
          "text": "冷たい麦茶を、ゆっくり飲みました。"
        },
        {
          "id": "original-p0004",
          "text": "この小さな箱には、何が入っているのでしょう。"
        },
        {
          "id": "original-p0005",
          "text": "電車が遅れたので、予定を少し変更します。"
        },
        {
          "id": "original-p0006",
          "text": "三つ目の角を右に曲がると、赤い屋根が見えます。"
        },
        {
          "id": "original-p0007",
          "text": "雨が止んだら、近くの公園まで散歩しよう。"
        },
        {
          "id": "original-p0008",
          "text": "新しい靴は軽くて、思ったより歩きやすかった。"
        },
        {
          "id": "original-p0009",
          "text": "えっ、本当にこれを一人で作ったんですか？"
        },
        {
          "id": "original-p0010",
          "text": "必要な資料を確認してから、もう一度ご連絡します。"
        }
      ]
    },
    {
      "id": "basic5000-pack01",
      "name": "BASIC5000 抑揚セット 1/6（50文）",
      "source": "jsut-basic5000",
      "prompts": [
        {
          "id": "BASIC5000_4873",
          "text": "ぶっちゃけ恵んでほしい。"
        },
        {
          "id": "BASIC5000_4842",
          "text": "姉さん、ちょっと相談に乗ってくれないか？"
        },
        {
          "id": "BASIC5000_3999",
          "text": "かつては、新夕張炭鉱などの炭鉱住宅街であったが、現在は、市営住宅が建つ。"
        },
        {
          "id": "BASIC5000_0793",
          "text": "お礼の申し上げようもございません。"
        },
        {
          "id": "BASIC5000_0741",
          "text": "松井、起死回生の逆転満塁サヨナラホームラン。"
        },
        {
          "id": "BASIC5000_4692",
          "text": "しまった、諮られたか。"
        },
        {
          "id": "BASIC5000_0776",
          "text": "非、暴力主義者のマハトラ・ガンジーは、１８９６年に生まれた。"
        },
        {
          "id": "BASIC5000_4765",
          "text": "撤収作業は、夜通し行われた。"
        },
        {
          "id": "BASIC5000_4958",
          "text": "私たちは、岐阜に行った。"
        },
        {
          "id": "BASIC5000_0499",
          "text": "アメリカンフットボールに、夢中なんだ。"
        },
        {
          "id": "BASIC5000_4141",
          "text": "スポーツ科学の研究成果が徐々に知られるようになり、科学的トレーニングによって、強い選手が育てられるようになった。"
        },
        {
          "id": "BASIC5000_4783",
          "text": "今年も白夜の季節がやってきた。"
        },
        {
          "id": "BASIC5000_2374",
          "text": "弁当を持っていく必要はないですよ。"
        },
        {
          "id": "BASIC5000_4437",
          "text": "骨髄抑制、間質性肺炎、皮膚潰瘍など。"
        },
        {
          "id": "BASIC5000_4769",
          "text": "装填が完了した。"
        },
        {
          "id": "BASIC5000_3501",
          "text": "そして、ルッチェランドで機神兵団と剣を交える。"
        },
        {
          "id": "BASIC5000_0297",
          "text": "ご一行様は、何名でいらっしゃいますか。"
        },
        {
          "id": "BASIC5000_3911",
          "text": "またこの時、現役時代と遜色ない火事場のクソ力で炎のランタンを激しく燃え上がらせている。"
        },
        {
          "id": "BASIC5000_3235",
          "text": "捕虜化によるプレイヤー間のキャラクター受け渡しも可能。"
        },
        {
          "id": "BASIC5000_4005",
          "text": "義兄であるエリュアードに好意を寄せている。"
        },
        {
          "id": "BASIC5000_3742",
          "text": "営業最終日は無料開放となり、閉店を惜しむファンが、全国から詰め掛けた。"
        },
        {
          "id": "BASIC5000_4054",
          "text": "校区は、倉吉市立成徳小学校、倉吉市立灘手小学校、倉吉市立上灘小学校の全域、倉吉市立社小学校の一部となっている。"
        },
        {
          "id": "BASIC5000_0520",
          "text": "ガブリエルは、熱いスープとシェリー酒を少し飲んだだけだった。"
        },
        {
          "id": "BASIC5000_2710",
          "text": "３隻の船が、女王から彼に与えられた。"
        },
        {
          "id": "BASIC5000_1716",
          "text": "鋼材不足にも関わらず、工業生産高は、５パーセントだけ増加した。"
        },
        {
          "id": "BASIC5000_1362",
          "text": "服は赤、ピンク、青色などであった。"
        },
        {
          "id": "BASIC5000_4704",
          "text": "僧侶が死ぬことを、入寂という。"
        },
        {
          "id": "BASIC5000_1755",
          "text": "彼ほど平々凡々たる主人公は、珍しい。"
        },
        {
          "id": "BASIC5000_0895",
          "text": "明後日のアポイントを取りたいのですが。"
        },
        {
          "id": "BASIC5000_3795",
          "text": "天之御中主神、高皇産霊神、神皇産霊神の、造化三神を、主神として祀る。"
        },
        {
          "id": "BASIC5000_0049",
          "text": "気前の良いその歯科医は、およそ２０億円を、慈善事業に寄付した。"
        },
        {
          "id": "BASIC5000_2180",
          "text": "楽しい時って、あっと言う間に時間過ぎちゃうんだよね。"
        },
        {
          "id": "BASIC5000_1384",
          "text": "お忘れになっただけかと思いました。"
        },
        {
          "id": "BASIC5000_1391",
          "text": "一匹の犬と、二人の人間がジャンプしている。"
        },
        {
          "id": "BASIC5000_1694",
          "text": "僕だったら成り行きを見守るだろうけど。"
        },
        {
          "id": "BASIC5000_2704",
          "text": "名所があまり多くて、１、２日で見るわけにはいかなかった。"
        },
        {
          "id": "BASIC5000_3459",
          "text": "妃が鏡美からもらったぬいぐるみが、世を忍ぶ仮の姿だった。"
        },
        {
          "id": "BASIC5000_1071",
          "text": "ほら、今日は海の幸だったから、明日は山の幸とかさ、採りに行こうよ．"
        },
        {
          "id": "BASIC5000_3652",
          "text": "マイコプラズマ脳炎、猫ひっかき病、赤痢アメーバ、熱帯熱マラリア、結核、リステリア、トキソプラズマなどの病原体でも、脳炎が起こることがある。"
        },
        {
          "id": "BASIC5000_3800",
          "text": "小坐骨切痕には、内閉鎖筋の坐骨包がみられる。"
        },
        {
          "id": "BASIC5000_4525",
          "text": "多くの英霊が散華して掴み取った平和を、我々は守っていかなくてはならない。"
        },
        {
          "id": "BASIC5000_0310",
          "text": "御自由にデザートをおとりください。"
        },
        {
          "id": "BASIC5000_3686",
          "text": "ナーシェンが出すはずだった竜騎士の援軍が来なかったため、立ち往生していた。"
        },
        {
          "id": "BASIC5000_3389",
          "text": "アポロドーロスによれば、兄弟にパルテノパイオス、プローナクス、メーキステウス、アリストマコス、エリピューレーがある。"
        },
        {
          "id": "BASIC5000_4001",
          "text": "現在ある医療技術系は、主に埼玉医科大学短期大学や神奈川歯科大学短期大学部などがある。"
        },
        {
          "id": "BASIC5000_1723",
          "text": "光線は、プリズムによって、七色に分解される。"
        },
        {
          "id": "BASIC5000_4840",
          "text": "五月雨や、蝉時雨、紅葉といった言葉は、季語だ。"
        },
        {
          "id": "BASIC5000_0354",
          "text": "ずば抜けた着想というのは、往々にして天啓のごとくヒラメクようだ。"
        },
        {
          "id": "BASIC5000_4229",
          "text": "谷間を縫うようにレイアウトされたシリーズお馴染みのオリジナルサーキットコース。"
        },
        {
          "id": "BASIC5000_1244",
          "text": "一旦風呂、アンド、飯落ち、４０分ぐらいして帰還。"
        }
      ]
    },
    {
      "id": "basic5000-pack02",
      "name": "BASIC5000 抑揚セット 2/6（50文）",
      "source": "jsut-basic5000",
      "prompts": [
        {
          "id": "BASIC5000_4854",
          "text": "これは供物ですか？"
        },
        {
          "id": "BASIC5000_0668",
          "text": "物価は安くなるどころか、高くなるばかりだった。"
        },
        {
          "id": "BASIC5000_1953",
          "text": "子ネコのしっぽを引っ張るとは、メアリーもいたずらっ子だった。"
        },
        {
          "id": "BASIC5000_3032",
          "text": "なお、次の者は認定講習を受講しなくても、産業保安監督部へ申請し、認定電気工事従事者認定証の交付を受けることができる。"
        },
        {
          "id": "BASIC5000_4839",
          "text": "よく冷ましてからお召し上がりください。"
        },
        {
          "id": "BASIC5000_1299",
          "text": "怒鳴りつけたかったが、思いとどまった。"
        },
        {
          "id": "BASIC5000_3512",
          "text": "学校区は大阪市立晴明丘小学校、大阪市立阪南中学校。"
        },
        {
          "id": "BASIC5000_3521",
          "text": "大人しそうな風貌の反面、剛田と付き合い始めてからは積極的に甘える。"
        },
        {
          "id": "BASIC5000_4319",
          "text": "人々は跪き、ツァーリにパンを請う。"
        },
        {
          "id": "BASIC5000_4672",
          "text": "夜空に月が懸かる。"
        },
        {
          "id": "BASIC5000_4361",
          "text": "そこへ、ランケデムがメドゥーラを連れて現れ、パシャは早速買い取る。"
        },
        {
          "id": "BASIC5000_2959",
          "text": "祖母は、私が彼女を訪問したとき、１週間ずっと病気だった。"
        },
        {
          "id": "BASIC5000_2296",
          "text": "お慈悲ですから、命ばかりはお助けを。"
        },
        {
          "id": "BASIC5000_0801",
          "text": "予防接種を受けていかなきゃいけない。"
        },
        {
          "id": "BASIC5000_3843",
          "text": "同じ見た目の面構署長とは、血縁関係はない。"
        },
        {
          "id": "BASIC5000_4087",
          "text": "過去に父親がセイシロウ達を逃がすために、ヴァサージの力を借り、ミューカスの大群に特攻。"
        },
        {
          "id": "BASIC5000_3245",
          "text": "やがて女官大勢頭部まで上り詰めていく。"
        },
        {
          "id": "BASIC5000_1504",
          "text": "ペイルエルは、アルコール含有量の少ないビールだ。"
        },
        {
          "id": "BASIC5000_4908",
          "text": "彼は老けて見える。"
        },
        {
          "id": "BASIC5000_3428",
          "text": "製紙業が盛んで、漁港のあった関係で、水産練製品製造業もあった。"
        },
        {
          "id": "BASIC5000_2236",
          "text": "行く手を阻んだものは、高さ、１メートル足らずの、石壁でした。"
        },
        {
          "id": "BASIC5000_1855",
          "text": "５階へは、エレベーターに乗りなさい。"
        },
        {
          "id": "BASIC5000_4774",
          "text": "読師によって、題目が読み上げられる。"
        },
        {
          "id": "BASIC5000_0930",
          "text": "土、日、月の、午前１０時半から、午後４時まで開館。"
        },
        {
          "id": "BASIC5000_1055",
          "text": "初心者がウィンドサーフィンをするのはむずかしい。"
        },
        {
          "id": "BASIC5000_4114",
          "text": "彼と共謀してジャックの捜査を妨害し、さらにはデュバクの協力者のデータを消去し、隠滅をはかる。"
        },
        {
          "id": "BASIC5000_4316",
          "text": "主な進学先は、学区内の中泊町立中里中学校である。"
        },
        {
          "id": "BASIC5000_4085",
          "text": "転換社債型新株予約権付社債は、各証券取引所に上場されているものも多い。"
        },
        {
          "id": "BASIC5000_3315",
          "text": "他言無用と言い残し、シャクロヴィートゥイが去ると、代書屋は、死んだ仲間の筆跡で書いてやった、奴は馬鹿野郎さ、と嘲る。"
        },
        {
          "id": "BASIC5000_2697",
          "text": "酒の神は、海の神より多くの人をおぼれさせた。"
        },
        {
          "id": "BASIC5000_2581",
          "text": "ロサンゼルス到着時刻は何時ですか。"
        },
        {
          "id": "BASIC5000_4663",
          "text": "非常に凝ったデザインのウェブサイトで、驚いた。"
        },
        {
          "id": "BASIC5000_2743",
          "text": "朝ごはんはなにがよろしいですか。"
        },
        {
          "id": "BASIC5000_3502",
          "text": "のち部下を引き連れて闇の中での暴虐の果てに富と権力を手に入れて皇コンツェルンを立ち上げて利益を貪る。"
        },
        {
          "id": "BASIC5000_3718",
          "text": "柿渋の塗られた紙を、渋紙と呼ぶ。"
        },
        {
          "id": "BASIC5000_2371",
          "text": "エヴェレスト山は、海抜２９、００２フィートです。"
        },
        {
          "id": "BASIC5000_0137",
          "text": "登場人物が、うまく割り振られていた。"
        },
        {
          "id": "BASIC5000_0673",
          "text": "超特急のぞみは、ひかりより速く走る。"
        },
        {
          "id": "BASIC5000_1100",
          "text": "フィリップス氏は、友人や隣人と一緒になって、祝宴を計画している。"
        },
        {
          "id": "BASIC5000_3380",
          "text": "即時削除タグ貼付後も、長期放置状態であることから、通常の削除依頼に切り替えます。"
        },
        {
          "id": "BASIC5000_3662",
          "text": "それはディルムン大陸に戦慄が走る瞬間だった。"
        },
        {
          "id": "BASIC5000_2387",
          "text": "頭韻の例を収集するために、シェークスピア・コンコーダンスを調べた。"
        },
        {
          "id": "BASIC5000_1073",
          "text": "もー、弥生のナビが判りにくいから、同じトコ、ぐるぐる回ったじゃない。"
        },
        {
          "id": "BASIC5000_3006",
          "text": "衆議院議員時代は日韓議員連盟、日韓海底トンネル推進議員連盟、神道政治連盟国会議員懇談会に所属していた。"
        },
        {
          "id": "BASIC5000_0660",
          "text": "宙返りするジェットコースターに乗ったら、気持ち悪くなっちゃった。"
        },
        {
          "id": "BASIC5000_2915",
          "text": "あぶく銭を稼ごうとする開発業者たちよ。"
        },
        {
          "id": "BASIC5000_3167",
          "text": "ジュルダンは、妻と女中に自分の新しい知識を見せつけようとするが、結局、面目丸つぶれに終わる。"
        },
        {
          "id": "BASIC5000_2687",
          "text": "雨のせいで、私たちはピクニックに行けなかった。"
        },
        {
          "id": "BASIC5000_0706",
          "text": "お天気が良かったので、郊外を散歩した。"
        },
        {
          "id": "BASIC5000_3568",
          "text": "だが、この批判は、一部のグノーシス派を除き、グノーシス主義全般に当てはまるものではない。"
        }
      ]
    },
    {
      "id": "basic5000-pack03",
      "name": "BASIC5000 抑揚セット 3/6（50文）",
      "source": "jsut-basic5000",
      "prompts": [
        {
          "id": "BASIC5000_2353",
          "text": "おめーらアイルランド人は、みんな飲兵衛らしいじゃねーか。"
        },
        {
          "id": "BASIC5000_4868",
          "text": "ケイコちゃんって憎らしい。"
        },
        {
          "id": "BASIC5000_2840",
          "text": "ウェイトレスは、客たちに給仕するのに、せわしく動き回った。"
        },
        {
          "id": "BASIC5000_4988",
          "text": "あいつら酔い潰れちゃった。"
        },
        {
          "id": "BASIC5000_1458",
          "text": "ヒューズさん、ピーター・ブラウンです。"
        },
        {
          "id": "BASIC5000_3803",
          "text": "安井の作品は、多彩を極め、初期のピクトリアリスムから、ストレートフォトグラフィ、フォトモンタージュ、街角のスナップにまで及ぶ。"
        },
        {
          "id": "BASIC5000_4878",
          "text": "列車は、神戸駅を出た。"
        },
        {
          "id": "BASIC5000_4877",
          "text": "公定歩合を引き下げた。"
        },
        {
          "id": "BASIC5000_1170",
          "text": "剣歯虎が絶滅したのは、氷河時代であった。"
        },
        {
          "id": "BASIC5000_4038",
          "text": "駒澤大学傘下の男女共学高校で、設置者は学校法人駒澤大学。"
        },
        {
          "id": "BASIC5000_4055",
          "text": "俳句のほかにも豊かな文学的教養に裏打ちされた随筆、小説、女性俳人研究なども残しており、これらも死後に、長女によって刊行されている。"
        },
        {
          "id": "BASIC5000_4532",
          "text": "サッカー日本対オーストラリアの戦いの火蓋が切って落とされた。"
        },
        {
          "id": "BASIC5000_3430",
          "text": "神出鬼没で、どこからともなく現れる。"
        },
        {
          "id": "BASIC5000_0497",
          "text": "ってゆーか、こうやってぐじぐじ考えるのが、情けないんじゃないのか。"
        },
        {
          "id": "BASIC5000_5000",
          "text": "あと３０分の猶予が与えられた。"
        },
        {
          "id": "BASIC5000_4936",
          "text": "ツバサは両翼を広げた。"
        },
        {
          "id": "BASIC5000_2646",
          "text": "ホットドッグ２こ、辛子と、ケチャップつきでおねがいします。"
        },
        {
          "id": "BASIC5000_3639",
          "text": "その上、ディオニューソスは獅子へと変じ、船の中央に熊を召喚した。"
        },
        {
          "id": "BASIC5000_1933",
          "text": "小田茜は、美少女コンテスト上がりの女優だ。"
        },
        {
          "id": "BASIC5000_4850",
          "text": "立ち退きの予告を受けた。"
        },
        {
          "id": "BASIC5000_2067",
          "text": "夢に欠けている主な事は、首尾一貫性である。"
        },
        {
          "id": "BASIC5000_2946",
          "text": "法隆寺は、世界最古の木造建築である。"
        },
        {
          "id": "BASIC5000_1782",
          "text": "街中で、イチャイチャするカップル見たら、腹立ちませんか。"
        },
        {
          "id": "BASIC5000_2994",
          "text": "一般的には、丈の低いものが笹竹の略とされる。"
        },
        {
          "id": "BASIC5000_3976",
          "text": "レバーを引き上げ、尾栓を、反時計回りに、ネジ溝がない場所まで回転させて、ロックを解除する。"
        },
        {
          "id": "BASIC5000_0585",
          "text": "ハツカネズミとドブネズミは異なる。"
        },
        {
          "id": "BASIC5000_2989",
          "text": "荘厳な寺院で、神聖な儀式が行われた。"
        },
        {
          "id": "BASIC5000_0991",
          "text": "疫病管理局の報告では、罹患率は１０パーセントだった。"
        },
        {
          "id": "BASIC5000_1104",
          "text": "フェアにやろうとは申しませんけど、無思慮な行動はおやめ頂きたいですわ。"
        },
        {
          "id": "BASIC5000_0186",
          "text": "メロスは、決してうそつきではない。"
        },
        {
          "id": "BASIC5000_4927",
          "text": "日本の最高峰は、富士山である。"
        },
        {
          "id": "BASIC5000_0695",
          "text": "夏、イギリスでは、朝４時ごろに日が昇る。"
        },
        {
          "id": "BASIC5000_0454",
          "text": "トイレットペーパーの買い置きがある。"
        },
        {
          "id": "BASIC5000_1880",
          "text": "合格者の過半数は、大学出身者であった。"
        },
        {
          "id": "BASIC5000_2234",
          "text": "腹がたったら十数えよ、もっと腹がたったら、百数えよ。"
        },
        {
          "id": "BASIC5000_0696",
          "text": "新東京国際空港から、東京に行く方法としては、列車や、リムジンバスがあります。"
        },
        {
          "id": "BASIC5000_0372",
          "text": "ベティがパーティーに来た最初の女の子だった。"
        },
        {
          "id": "BASIC5000_1393",
          "text": "修道士のように頭巾をかぶった雲は、ポツリポツリと、落ちる雨を数珠のようにつまぐっている。"
        },
        {
          "id": "BASIC5000_0157",
          "text": "３番目に考慮すべき事柄は、カーペットの時代性である。"
        },
        {
          "id": "BASIC5000_0734",
          "text": "無鉄砲に当たるも当たらぬもみな運命だ。"
        },
        {
          "id": "BASIC5000_0820",
          "text": "ドレスが塗りたてのペンキがついてるよ。"
        },
        {
          "id": "BASIC5000_2007",
          "text": "キング牧師は、それに続く数年間にわたって、アメリカ中で行われた抗議運動や、デモを指導した。"
        },
        {
          "id": "BASIC5000_3736",
          "text": "塩酸を、水酸化ナトリウム水溶液で、滴定する場合を考える。"
        },
        {
          "id": "BASIC5000_1208",
          "text": "御近くにおいでの節は、ぜひ御立ち寄りください。"
        },
        {
          "id": "BASIC5000_4161",
          "text": "しかし、ベレー帽が脱げると、なぜか下手な絵しか描けなくなってしまう。"
        },
        {
          "id": "BASIC5000_4400",
          "text": "スイスチャードの名前で、種苗店で販売される。"
        },
        {
          "id": "BASIC5000_3370",
          "text": "なお、小田急グループ全体としては、小田急電鉄沿線に、以下の事業者が線路を有している。"
        },
        {
          "id": "BASIC5000_3992",
          "text": "ノタニー博士の変装時と、本編登場時の髪型と、眉毛の形状が異なる。"
        },
        {
          "id": "BASIC5000_4625",
          "text": "栄えある業績を残す。"
        },
        {
          "id": "BASIC5000_4181",
          "text": "コース麓にチケット売り場がある。"
        }
      ]
    },
    {
      "id": "basic5000-pack04",
      "name": "BASIC5000 抑揚セット 4/6（50文）",
      "source": "jsut-basic5000",
      "prompts": [
        {
          "id": "BASIC5000_4874",
          "text": "祝詞も知らないのか？"
        },
        {
          "id": "BASIC5000_4108",
          "text": "しかし、ビーダキャリバーのみが、彼を滅ぼすことができる。"
        },
        {
          "id": "BASIC5000_3250",
          "text": "現在の東京慈恵会医科大学葛飾医療センターである。"
        },
        {
          "id": "BASIC5000_2969",
          "text": "証書貸付は、連帯保証人が必要でした。"
        },
        {
          "id": "BASIC5000_1567",
          "text": "局地的な大雨だったらしいけど、行かなくて正解だったよ。"
        },
        {
          "id": "BASIC5000_4627",
          "text": "疫病神に取り憑かれる。"
        },
        {
          "id": "BASIC5000_1927",
          "text": "欧州共同体の１２ヶ国は、農産物価格についての妥協案を作成しています。"
        },
        {
          "id": "BASIC5000_2372",
          "text": "エンパイアステートビルの高さは、どのくらいですか。"
        },
        {
          "id": "BASIC5000_1803",
          "text": "１平方メートルの太陽光発電パネルの出力は、約１ワットであり、今のところ、大規模に太陽電力を利用するのは困難である。"
        },
        {
          "id": "BASIC5000_0498",
          "text": "アーケード天井に、たくさんの張りぼてが飾られてた。"
        },
        {
          "id": "BASIC5000_3095",
          "text": "シルヴィネには、奉公は耐えられないだろうと思ったからだ。"
        },
        {
          "id": "BASIC5000_4713",
          "text": "我が身の不幸を愁える。"
        },
        {
          "id": "BASIC5000_1322",
          "text": "鳥居と言うと、階段を上がったところにあった、赤いオブジェ。"
        },
        {
          "id": "BASIC5000_4849",
          "text": "吹雪でえらい目に遭った。"
        },
        {
          "id": "BASIC5000_4093",
          "text": "ロパーヒンは、ワーリャへのプロポーズを決意するが、土壇場でやめてしまう。"
        },
        {
          "id": "BASIC5000_3211",
          "text": "夕陽が傾き、寂光院の鐘が鳴ると、後白河は名残惜しく思いながら、涙を抑えて還御した。"
        },
        {
          "id": "BASIC5000_2173",
          "text": "鉦や太鼓で探しあてた割には、あいつ、期待はずれだったよな。"
        },
        {
          "id": "BASIC5000_1762",
          "text": "彼ぐらいハンサムだったらいいのになあ。"
        },
        {
          "id": "BASIC5000_4990",
          "text": "意気地が、なかったんだ。"
        },
        {
          "id": "BASIC5000_2601",
          "text": "非、ヴァーチャルアドレス帳を、数分前に見つけたところです。"
        },
        {
          "id": "BASIC5000_3508",
          "text": "毎年、体育祭のフィナーレを彩る。"
        },
        {
          "id": "BASIC5000_4375",
          "text": "体は噛みつかれた痕の歯形だらけ。"
        },
        {
          "id": "BASIC5000_2923",
          "text": "あごひげがあるだけで、哲学者にはなれぬ。"
        },
        {
          "id": "BASIC5000_2065",
          "text": "東加古川行きの電車は、何番線からでますか。"
        },
        {
          "id": "BASIC5000_2459",
          "text": "他力本願じゃ、世の中渡っていけないよ。"
        },
        {
          "id": "BASIC5000_4819",
          "text": "同じ頃、中東でペルシャ帝国が勃興した。"
        },
        {
          "id": "BASIC5000_3071",
          "text": "コケ植物門、苔綱ゼニゴケ目に属するもの。"
        },
        {
          "id": "BASIC5000_0922",
          "text": "この辞書は、第３巻が今欠けていますが、百ドルでした。"
        },
        {
          "id": "BASIC5000_4048",
          "text": "プレスに対しても、スペシャルステージスタート後のコース横断禁止や、規制テープ内のみの取材活動等が厳命され、後に、物議を醸すことになった。"
        },
        {
          "id": "BASIC5000_0263",
          "text": "壁はぬりかえなければなりませんか。"
        },
        {
          "id": "BASIC5000_3491",
          "text": "餃子、ロールキャベツ、串カツ、ソーセージ、ミートパイなど、肉類の冷凍加工食品の生産が中心だった。"
        },
        {
          "id": "BASIC5000_1963",
          "text": "マニュアルシフトで運転できますか。"
        },
        {
          "id": "BASIC5000_0104",
          "text": "増加する需要に応じるため、アメリカから、牛肉を追加する計画だ。"
        },
        {
          "id": "BASIC5000_0464",
          "text": "コズビの議論は、ヘッテ写本の信頼性に関するものである。"
        },
        {
          "id": "BASIC5000_0300",
          "text": "ご両親に、どうぞよろしくお伝えください。"
        },
        {
          "id": "BASIC5000_4751",
          "text": "他のものは何もいらない。"
        },
        {
          "id": "BASIC5000_4254",
          "text": "本年度も全日程が園田競馬場で開催され、姫路競馬場での開催はなかった。"
        },
        {
          "id": "BASIC5000_2177",
          "text": "プディングのうまいまずいは、食べてみてから。"
        },
        {
          "id": "BASIC5000_2519",
          "text": "８時に学校に行くのは、定められたルールです。"
        },
        {
          "id": "BASIC5000_2571",
          "text": "やるからには、ちゃんとやりなさい。"
        },
        {
          "id": "BASIC5000_3892",
          "text": "筑波山東方の峰、女体山を登るロープウェイで、つつじヶ丘駅は、筑波スカイラインの終点近く、女体山駅は、女体山山頂近くにある。"
        },
        {
          "id": "BASIC5000_1102",
          "text": "ファーストネームでお呼びすることをお許し下さい。"
        },
        {
          "id": "BASIC5000_3863",
          "text": "そして、ゾヌーダとの戦いが終わった直後、号泣する。"
        },
        {
          "id": "BASIC5000_1886",
          "text": "馬が哺乳動物であると同様、鯨も、哺乳動物である。"
        },
        {
          "id": "BASIC5000_0568",
          "text": "値札を取りはずしていただけますか。"
        },
        {
          "id": "BASIC5000_1280",
          "text": "絹は手触りが柔らかく、すべすべしている。"
        },
        {
          "id": "BASIC5000_3950",
          "text": "主要な農業生産物は、灌漑農業による綿花、麻のほか、穀物、メロン、ヒョウタン、柑橘類などである。"
        },
        {
          "id": "BASIC5000_0656",
          "text": "赤ん坊が浴槽の中で、ぼちゃぼちゃやっていた。"
        },
        {
          "id": "BASIC5000_4415",
          "text": "特技は栃木弁丸出しのしゃべりである。"
        },
        {
          "id": "BASIC5000_1108",
          "text": "驚きのあまり、私はくちがきけなかった。"
        }
      ]
    },
    {
      "id": "basic5000-pack05",
      "name": "BASIC5000 抑揚セット 5/6（50文）",
      "source": "jsut-basic5000",
      "prompts": [
        {
          "id": "BASIC5000_0404",
          "text": "巡査は、いつものように夜間の巡回中だった。"
        },
        {
          "id": "BASIC5000_2622",
          "text": "前髪は短く切りすぎないでください。"
        },
        {
          "id": "BASIC5000_4503",
          "text": "羨ましいほどの落ち着きぶりであった。"
        },
        {
          "id": "BASIC5000_3719",
          "text": "初期のプラグは、木片を削って作った浮力の高いもので、すべて水に浮く、トップウォータープラグであった。"
        },
        {
          "id": "BASIC5000_4884",
          "text": "夜が更け始めた。"
        },
        {
          "id": "BASIC5000_3840",
          "text": "基礎課程学校と幼稚園は、ロンドルフと、リュディングスハウゼン地区にある。"
        },
        {
          "id": "BASIC5000_2847",
          "text": "ウォルターは、ジョンのひどい侮辱に面食らった。"
        },
        {
          "id": "BASIC5000_0181",
          "text": "代議民主制は、１つの政治形態である。"
        },
        {
          "id": "BASIC5000_4995",
          "text": "弾劾裁判がひらかれる。"
        },
        {
          "id": "BASIC5000_0790",
          "text": "今更そんなことを言った日にゃ、火に油を注ぐことになるだけだよ。"
        },
        {
          "id": "BASIC5000_4547",
          "text": "かっぱ寿司は、リーズナブルな回転寿司のチェーン店だ。"
        },
        {
          "id": "BASIC5000_2914",
          "text": "あふれんばかりの美しい陽射しであった。"
        },
        {
          "id": "BASIC5000_4696",
          "text": "厳しい叱責を受ける。"
        },
        {
          "id": "BASIC5000_4112",
          "text": "手延べそうめん類製造作業、機械生麺製造作業、機械乾麺製造作業ともに、単一等級のみである。"
        },
        {
          "id": "BASIC5000_4506",
          "text": "長らくドサ廻りが続いたが、戦後は、道頓堀角座に出演した。"
        },
        {
          "id": "BASIC5000_4941",
          "text": "待てば、海路の、日和あり。"
        },
        {
          "id": "BASIC5000_2616",
          "text": "デニスは、ウィルソンさんの丸い顔をあざ笑う。"
        },
        {
          "id": "BASIC5000_3930",
          "text": "ナイフやダーツを持つと、たとえ、おもちゃであっても不気味に微笑む。"
        },
        {
          "id": "BASIC5000_4250",
          "text": "ノンフィクション作家の土本亜理子は実娘。"
        },
        {
          "id": "BASIC5000_4862",
          "text": "今日のトピックは、北朝鮮による、日本人拉致問題です。"
        },
        {
          "id": "BASIC5000_4630",
          "text": "汚れた世の中に産み落とされる。"
        },
        {
          "id": "BASIC5000_0657",
          "text": "１分だって、ほぼ４ポンドかかるんだから。"
        },
        {
          "id": "BASIC5000_3550",
          "text": "簡単に詰むように見せるため、最初の駒数が少なく小さくまとまっている物が多い。"
        },
        {
          "id": "BASIC5000_2110",
          "text": "ナポレオンは、セントヘレナ島へ流された。"
        },
        {
          "id": "BASIC5000_4622",
          "text": "経緯を確認する。"
        },
        {
          "id": "BASIC5000_3021",
          "text": "中庸を踏み外すときに、躊躇しないやつは馬鹿だと思う。"
        },
        {
          "id": "BASIC5000_3078",
          "text": "ダム堤体中央部に、洪水吐を設置し、天端より、湖水の放流を行うものである。"
        },
        {
          "id": "BASIC5000_1720",
          "text": "美和子さん、こちら、ケニーさんです。"
        },
        {
          "id": "BASIC5000_0374",
          "text": "ベニヤ板で十分だとのこと、教えられたとおり、ベニヤ板で作ることにします。"
        },
        {
          "id": "BASIC5000_2952",
          "text": "ネイティブアメリカンは、弓と矢でたたかった。"
        },
        {
          "id": "BASIC5000_0148",
          "text": "５ドルぐらいしか持ち合わせがない。"
        },
        {
          "id": "BASIC5000_0047",
          "text": "鉱山労働者が、賃上げを要求してストに突入した。"
        },
        {
          "id": "BASIC5000_3747",
          "text": "信濃川河口周辺の新潟海岸では、海岸浸食が顕著である。"
        },
        {
          "id": "BASIC5000_1502",
          "text": "ペギーは、演劇を見に行かなかったが、私も行かなかった。"
        },
        {
          "id": "BASIC5000_0024",
          "text": "システィナ礼拝堂は、１４７３年に、バティカン宮殿内に建立された、壮大な礼拝堂です。"
        },
        {
          "id": "BASIC5000_4412",
          "text": "吸血鬼にとって神聖な天体である月の魔力を完璧に操り生み出される、月匠の魔法細工は、あらゆる血統の美術的崇拝の対象となっている。"
        },
        {
          "id": "BASIC5000_0109",
          "text": "袋は、とうもろこしではちきれそうだった。"
        },
        {
          "id": "BASIC5000_1173",
          "text": "蓄音機は、エジソンの頭脳から生まれた。"
        },
        {
          "id": "BASIC5000_3273",
          "text": "ブラエススは、アウグストゥスの喪と、新皇帝ティベリウス即位の祝賀のため、夏期陣地に集結していた、指揮下の軍団兵に対し、休暇を与えた。"
        },
        {
          "id": "BASIC5000_4203",
          "text": "防霜ファンのみでは対応できないほど冷え込む場合は、ビニールシートなどを併用する。"
        },
        {
          "id": "BASIC5000_2441",
          "text": "省エネルギーの全国運動が展開中だ。"
        },
        {
          "id": "BASIC5000_4442",
          "text": "ブックレットの記述では、玲音よりも遥かに女の業を煮やす少女。"
        },
        {
          "id": "BASIC5000_1710",
          "text": "御急ぎでなかったら、御茶か何かいかがですか。"
        },
        {
          "id": "BASIC5000_2464",
          "text": "小包は８月１７日にロンドンに到着の予定です。"
        },
        {
          "id": "BASIC5000_4121",
          "text": "同じ名字だが、二卵性双生児の姉妹なのかは不明。"
        },
        {
          "id": "BASIC5000_1487",
          "text": "見る日は、レークジェニーバをかたどって、池を造った。"
        },
        {
          "id": "BASIC5000_3354",
          "text": "プロジェクトセガガガ反対派であったが、ストーリー中盤におけるセガ経営陣の混乱に乗じて本社に乗り込み、プロジェクトセガガガの責任者に納まる。"
        },
        {
          "id": "BASIC5000_1098",
