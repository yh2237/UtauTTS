+class NaturalCubicSpline {
+ public:
+  NaturalCubicSpline(const std::vector<double>& x,
+                     const std::vector<double>& y)
+      : x_(x), y_(y), b_(x.size() - 1), c_(x.size()), d_(x.size() - 1) {
+    const int size = static_cast<int>(x_.size());
+    std::vector<double> h(size - 1);
+    for (int i = 0; i < size - 1; ++i) {
+      h[i] = x_[i + 1] - x_[i];
+    }
+
+    std::vector<double> alpha(size, 0);
+    for (int i = 1; i < size - 1; ++i) {
+      alpha[i] = 3 * (y_[i + 1] - y_[i]) / h[i] -
+                 3 * (y_[i] - y_[i - 1]) / h[i - 1];
+    }
+
+    std::vector<double> lower(size, 1);
+    std::vector<double> ratio(size, 0);
+    std::vector<double> solution(size, 0);
+    for (int i = 1; i < size - 1; ++i) {
+      lower[i] = 2 * (x_[i + 1] - x_[i - 1]) - h[i - 1] * ratio[i - 1];
+      ratio[i] = h[i] / lower[i];
+      solution[i] =
+          (alpha[i] - h[i - 1] * solution[i - 1]) / lower[i];
+    }
+
+    for (int i = size - 2; i >= 0; --i) {
+      c_[i] = solution[i] - ratio[i] * c_[i + 1];
+      b_[i] = (y_[i + 1] - y_[i]) / h[i] -
+              h[i] * (c_[i + 1] + 2 * c_[i]) / 3;
+      d_[i] = (c_[i + 1] - c_[i]) / (3 * h[i]);
+    }
+  }
+
+  double Evaluate(double x) const {
+    auto upper = std::upper_bound(x_.begin(), x_.end(), x);
+    int index = std::clamp(
+        static_cast<int>(upper - x_.begin()) - 1, 0,
+        static_cast<int>(x_.size()) - 2);
+    double offset = x - x_[index];
+    return y_[index] + b_[index] * offset + c_[index] * offset * offset +
+           d_[index] * offset * offset * offset;
+  }
+
+ private:
+  std::vector<double> x_;
+  std::vector<double> y_;
+  std::vector<double> b_;
+  std::vector<double> c_;
+  std::vector<double> d_;
+};
+
